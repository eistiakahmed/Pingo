# Pingo Production Environment Variables for AWS Lightsail
# Copy this file to .env.prod on the server: cp .env.prod.example .env.prod

# Server Domain or Public IP (If you have a domain like api.pingo.app, put it here. Otherwise use your Lightsail Static IP)
DOMAIN_NAME=your-lightsail-static-ip

# Database Credentials
POSTGRES_USER=pingo_admin
POSTGRES_PASSWORD=generate_a_strong_password_here_min_32_chars

# Application Security (Generate a random 64-char key: openssl rand -hex 32)
SECRET_KEY=generate_a_random_secret_key_here

# AI Configuration
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=your_deepseek_api_key_here
GEMINI_API_KEY=
